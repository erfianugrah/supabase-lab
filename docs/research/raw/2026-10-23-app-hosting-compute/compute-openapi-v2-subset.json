                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Mint a presigned slot for a build-context upload",
        "tags": [
          "Compute"
        ],
        "x-badges": [
          {
            "name": "OAuth scope: edge_functions:write",
            "position": "after"
