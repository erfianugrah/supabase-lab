    "/v2/projects/{ref}/compute/{name}/uploads": {
      "post": {
        "description": "PUT the `.tar.gz` build context to the returned `url` before `expires_at`, then deploy with the upload id as `context_upload_id`. The bytes go straight to storage -- no management API request carries them.\n\nThis endpoint is currently in its **Alpha** stage.",
        "operationId": "v2-create-compute-instance-upload",
        "parameters": [
          {
            "name": "ref",
            "required": true,
            "in": "path",
            "description": "Project ref",
            "schema": {
              "minLength": 20,
              "maxLength": 20,
              "pattern": "^[a-z]+$",
              "example": "abcdefghijklmnopqrst",
              "type": "string"
            }
          },
          {
            "name": "name",
            "required": true,
            "in": "path",
            "schema": {
              "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
              "example": "hello-world",
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2ComputeInstanceUploadResponse_Output"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
