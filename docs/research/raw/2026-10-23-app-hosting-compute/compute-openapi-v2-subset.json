            }
          },
          {
            "name": "name",
            "required": true,
            "in": "path",
            "schema": {
              "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
              "example": "hello-world",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
