# tofu state - never commit
*.tfstate
*.tfstate.*
.terraform/
.terraform.tfstate.lock.info

# var files: only templates and non-secret experiment config are committed
*.tfvars
!secrets.example.tfvars
!secrets.enc.tfvars
!experiment.tfvars

# plans
tfplan
*.tfplan

# test evidence (may contain connection details)
evidence/

# lambda build artifacts (anchored anywhere - these live under experiments/*/)
**/lambda/dist/
**/lambda/node_modules/
**/lambda/function.zip

# sops plaintext
secrets.tfvars

# tofu plan files (zip archives; embed tfstate incl. variable values)
tfplan-*

# bun workspace
node_modules/

# Loop harness manifests: local tooling, and they carry absolute paths from
# whichever machine wrote them.
.pi/

# dart pub artifacts
.dart_tool/
.pub/
pubspec.lock

# stray harness run artifacts
harness/out/

# run artifacts (like evidence/) - never commit
**/out/
# ...except the REDACTED, published copies an experiment writes with
# `bun harness/scripts/publish-evidence.ts` into a DATED subdirectory - refs,
# hostnames and emails replaced; these are what RUNLOGs and the docs site
# cite. Raw artifacts dropped at out/ root stay ignored. Git cannot re-include
# a path under an excluded directory, so the out/ directory itself is
# re-included first, its direct children ignored again, then the dated
# subdirectories re-included.
!experiments/*/out/
experiments/*/out/*
!experiments/*/out/20*/

# wrangler dev local state (miniflare cache, sqlite, trace store) - regenerable
**/.wrangler/
