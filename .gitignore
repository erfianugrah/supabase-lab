# tofu state - never commit
*.tfstate
*.tfstate.*
.terraform/
.terraform.tfstate.lock.info

# var files: only templates and non-secret experiment config are committed
*.tfvars
!secrets.example.tfvars
!secrets.enc.tfvars
!experiment.tfvars

# plans
tfplan
*.tfplan

# test evidence (may contain connection details)
evidence/

# lambda build artifacts (anchored anywhere - these live under experiments/*/)
**/lambda/dist/
**/lambda/node_modules/
**/lambda/function.zip

# sops plaintext
secrets.tfvars

# tofu plan files (zip archives; embed tfstate incl. variable values)
tfplan-*

# bun workspace
node_modules/

# Loop harness manifests: local tooling, and they carry absolute paths from
# whichever machine wrote them.
.pi/

# dart pub artifacts
.dart_tool/
.pub/
pubspec.lock
