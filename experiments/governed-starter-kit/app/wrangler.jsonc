{
  // Deployed to <name>.<subdomain>.workers.dev - no custom domain, so
  // `make destroy` can remove it with `wrangler delete` and nothing else.
  // The Supabase URL and publishable key are build-time NEXT_PUBLIC_* values
  // from .env.production, which the Makefile writes from tofu output.
  "name": "starter-kit-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
